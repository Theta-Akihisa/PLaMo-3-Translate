{
  "name": "plamo-3-translate-chrome-extension",
  "version": "0.1.0",
  "private": true,
  "description": "PLaMo 3 Translate をローカルで動かす Chrome 拡張機能 (Manifest V3)",
  "type": "module",
  "scripts": {
